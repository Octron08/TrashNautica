            extends:
              cgroup: ''
            hidden: false
            cache: true
        extends: {}
        lastmod: 1775598133181
        events:
          - eventKey: OnRoomStart
            code: |-
              rooms.append('UI', {
              isUI: true
              });

              sounds.play('moseni', { loop: true });
              sounds.play('Ambience', { loop: true });

              sounds.volume('moseni', 0.7);
              sounds.volume('Ambience', 0.3);

              camera.follow = null;
              camera.minX = -Infinity;
              camera.maxX = +Infinity;
              camera.minY = 0;
              camera.maxY = +Infinity;

              this.cx = camera.width;
              this.cy = camera.height;

              camera.followX = false;
              camera.follow = templates.list["ghost"][0];
            arguments: {}
            lib: core
          - eventKey: OnRoomEnd
            code: |-
              this.kill = true;

              sounds.stop('Ambience');
              sounds.stop('moseni');
            arguments: {}
            lib: core
          - eventKey: OnDraw
            code: |+
              let g1 = templates.list["Giocatore1"][0];
              let g2 = templates.list["Giocatore2"][0];
              let margin = 200;

              let targetX = (g1.x + g2.x) / 2;
              let targetY = (g1.y + g2.y) / 2;

              let zoomX = Math.abs(g1.x - g2.x) / (this.cx - margin);
              let zoomY = Math.abs(g1.y - g2.y) / (this.cy - margin);

              let targetScale = Math.max(1.0, zoomX, zoomY);
              let ghost = templates.list["ghost"][0]
              ghost.x = targetX;
              ghost.y = targetY;

              camera.x = u.lerp(camera.x, targetX, 0.2);
              camera.y = u.lerp(camera.y, targetY, 0.2);
              camera.scale.x = u.lerp(camera.scale.x, targetScale, 0.2);
              camera.scale.y = u.lerp(camera.scale.y, targetScale, 0.2);

            arguments: {}
            lib: core
        behaviors: []
        extendTypes: ''
        uid: qHGRDbKPggp36C
        lastPickedTileset: 5k8hP4bdmFHF2D
