      - type: folder
        uid: 79kQbKmF72Nbdq
        colorClass: act
        icon: help-circle
        name: Nemici
        lastmod: 1774250395620
        entries:
          - type: template
            baseClass: AnimatedSprite
            name: Pesce Palla
            depth: 10
            texture: 3hwRW3GkH9M4Bj
            playAnimationOnStart: true
            loopAnimation: true
            animationFPS: 4
            visible: true
            events:
              - eventKey: OnStep
                lib: core
                code: |-
                  if (!pause.isPaused) {
                      // move() calculates the next x/y based on speed and direction
                      // but doesn't apply it yet. 
                      
                      // We check if the NEXT horizontal step will hit a wall
                      let dx = Math.cos(this.direction * Math.PI / 180) * this.speed;
                      
                      if (place.occupied(this, this.x + dx, this.y, 'Terreno')) {
                          // Flip direction
                          this.direction = (this.direction === 0) ? 180 : 0;
                          this.scale.x *= -1;
                      }

                      this.move();
                  }
                arguments: {}
              - eventKey: OnCreate
                code: |-
                  this.speed = 150;
                  this.direction = 0;
                  this.scale.x = 0.5;
                  this.scale.y = 0.5;
                arguments: {}
                lib: core
            extends:
              cgroup: Nemici
              'editor:myCollidingCGroups': []
            lastmod: 1775595611664
            uid: MPdrNr8hhh5b2R
            behaviors: []
            extendTypes: ''
          - type: template
            baseClass: AnimatedSprite
            name: Medusa
            depth: 10
            texture: GgCk1fwPDqDpj8
            playAnimationOnStart: true
            loopAnimation: true
            animationFPS: 4
            visible: true
            events:
              - eventKey: OnStep
                lib: core
                code: |-
                  if (!pause.isPaused) {
                      if (place.occupied(this, this.x, this.y + 5, 'Terreno')) {
                          this.direction = 270;  //direzione verso l'alto
                      } else if (place.occupied(this, this.x, this.y - 5, 'Terreno')) {
                          this.direction = 90;  //direzione verso il basso
                      }

                      this.move();
                  }
                arguments: {}
              - eventKey: OnCreate
                code: |-
                  this.speed = 150;
                  this.direction = 90;
                  this.scale.x = 2;
                  this.scale.y = 2;
                arguments: {}
                lib: core
            extends:
              cgroup: Nemici
              'editor:myCollidingCGroups': []
            lastmod: 1775595571106
            uid: gMww9zTNWQRDPT
            behaviors: []
            extendTypes: ''
      - type: folder
        uid: NDb6d6b9pqf89K
        colorClass: text
        icon: smiley-frown
        name: Collezionabili
        lastmod: 1774434010865
        entries:
          - type: template
            baseClass: AnimatedSprite
            name: Spazzatura_grande
            depth: 0
            texture: 2JtFWz3rPzL3R7
            playAnimationOnStart: false
            loopAnimation: true
            animationFPS: 30
            visible: true
            events:
              - eventKey: OnCreate
                code: |-
                  this.isCollected = false;
                  sounds.play('Generazione Spazzatura');
                  this.tex = "Grande" + Math.floor(Math.random() * 2 + 1);
                arguments: {}
                lib: core
              - eventKey: collisionCGroup
                code: >-
                  if (!this.isCollected && !place.occupied(this, this.x, this.y,
                  'Giocatore').hasCollidedWithEnemy) {
                      sounds.play('Raccolta');
                      this.isCollected = true;
                      place.occupied(this, this.x, this.y, 'Giocatore').spazzaturaGrande.push(this);
                  }
                arguments:
                  group: Giocatore
                lib: place
              - eventKey: OnStep
                code: this.move();
                arguments: {}
                lib: core
              - eventKey: OnDestroy
                code: |-
                  do {
                      var x = Math.floor(random(camera.maxX));
                      var y = Math.floor(random(camera.maxY));
                  } while (place.occupied(this, x, y, 'Terreno'));

                  setTimeout(() => {
                      templates.copy('Spazzatura_grande', x, y);
                      sounds.play('Generazione Spazzatura');
                  }, 2000 + Math.floor(Math.random() * 3 * 1000));
                arguments: {}
                lib: core
            extends:
              cgroup: ''
              'editor:myCollidingCGroups': []
            lastmod: 1775597569434
            uid: Q5Dz7qRNWK3PLm
            behaviors: []
            extendTypes: ''
