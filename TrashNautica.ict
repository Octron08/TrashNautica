          - type: template
            baseClass: SpritedCounter
            name: respiro
            depth: 0
            texture: RTT9rNng3HQmPJ
            playAnimationOnStart: false
            loopAnimation: true
            animationFPS: 30
            visible: true
            events:
              - eventKey: OnStep
                lib: core
                code: |

                  this.follow = templates.list[this.pFollow][0]
                  this.x = this.follow.x - 32
                  this.y = this.follow.y - 64
                  if (!pause.isPaused) {
                      this.follow.air -= 0.0004 * airDepletionRate * ((trashAirDepletionMultiplier * this.follow.spazzaturaGrande.length) + 1)
                      this.count = this.follow.air

                      // // --- LOGICA DEL LAMPEGGIO ---
                      // // 1. Facciamo scorrere il tempo
                      // this.tempoLampeggio += u.time;

                      // // 2. Controlliamo se siamo in zona pericolo
                      // if (this.follow.air < this.sogliaAllarme) {

                      //     // Più l'ossigeno è basso, più questo numero diventa grande (velocità maggiore)
                      //     // Moltiplica per 0.5 (o altro) per regolare quanto diventa "frenetico" alla fine
                      //     let velocita = 10 + (this.sogliaAllarme - this.follow.air) * 0.8;

                      //     // Math.sin crea un'onda tra -1 e 1. Noi la trasformiamo tra 0 (invisibile) e 1 (visibile)
                      //     this.alpha = 0.7 + (0.3 * Math.sin(this.tempoLampeggio * velocita));

                      //     // TOCCO DI CLASSE OPZIONALE: Diventa anche rossastro!
                      //     this.tint = 0xff5555;

                      // } else {
                      //     // Se l'ossigeno è sopra la soglia (o il giocatore raccoglie una bombola)
                      //     // riportiamo lo sprite alla normalità
                      //     this.alpha = 1;         // Visibilità al 100%
                      //     this.tint = 0xffffff;   // Colore originale
                      // }

                      if (this.follow.air <= 0) {
                          this.follow.enemyCollision();
                          this.follow.x = this.follow.spawnX;
                          this.follow.y = this.follow.spawnY;
                          this.follow.hspeed = 0;
                          this.follow.vspeed = 0;

                          if (this.follow.spazzaturaGrande.length > 0) {
                              for (let i of this.follow.spazzaturaGrande) i.kill = true;
                              this.follow.spazzaturaGrande = [];
                          }
                          this.follow.air = 3
                      }
                  }
                arguments: {}
              - eventKey: OnCreate
                code: |-
                  if (!airOption) this.kill = true
                  this.sogliaAllarme = .70
                arguments: {}
                lib: core
            extends:
              cgroup: ''
              'editor:myCollidingCGroups': []
            lastmod: 1776690586721
            uid: f4TD3bLf6B57Rh
            behaviors: []
            extendTypes: ''
            tilingSettings:
              scrollSpeedX: 0
              scrollSpeedY: 0
              pixelPerfect: false
              isUi: false
            repeaterSettings:
              defaultCount: 3
          - type: template
            baseClass: TextBox
            name: InputBool
            depth: 0
            texture: jfcJq6M6mKfBhP
            playAnimationOnStart: false
            loopAnimation: true
            animationFPS: 30
            visible: true
            events:
              - eventKey: OnTextChange
                code: |-
                  if (this.text == '0') {
                      globalThis[this.globalVariable] = false
                  }
                  else if (this.text == '1') {
                      globalThis[this.globalVariable] = true
                  }
                  else this.text = globalThis[this.globalVariable]
                arguments: {}
                lib: core
              - eventKey: OnCreate
                code: >-
                  console.log("La variabile scelta è "+this.globalVariable+" con
                  valore: "+globalThis[this.globalVariable])

                  if (this.text.length==0) this.text =
                  globalThis[this.globalVariable]
                arguments: {}
                lib: core
              - eventKey: OnPointerClick
                code: |
                  console.log("Il valore è: "+globalThis[this.globalVariable])
                arguments: {}
                lib: core
            extends:
              cgroup: ''
              'editor:myCollidingCGroups': []
