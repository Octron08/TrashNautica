        lastmod: 1775562832073
        events:
          - eventKey: OnRoomStart
            code: |-
              countDown = 60; // In secondi 

              this.isOver = false;


              this.text = "Tempo: " + Math.ceil(countDown).toString() + 's';
            arguments: {}
            lib: core
          - eventKey: OnDraw
            code: |-
              if (!this.isOver && !pause.isPaused) {
                  countDown -= u.time;

                  let timeInSec = Math.ceil(countDown);
                  if (timeInSec < 0) timeInSec = 0;
                  
                  let timerText = templates.list['Timer'][0];

                  if (timerText) {
                      timerText.text = "Tempo rimasto: " + timeInSec.toString();
                  }

                  if (countDown <= 0) {
                      this.finito = true;
                      
                      if (timerText) {
                          timerText.text = "FINE!";
                      }
                      
                      pause.togglePaused();
                      rooms.switch("risultati");
                  }
              }
            arguments: {}
            lib: core
        behaviors: []
        extendTypes: ''
        uid: w2JHmN6CqWDt9G
