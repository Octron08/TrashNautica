      - type: folder
        uid: 79kQbKmF72Nbdq
        colorClass: act
        icon: help-circle
        name: Nemici
        lastmod: 1774250395620
        entries:
          - type: template
            baseClass: AnimatedSprite
            name: Pesce Palla
            depth: 10
            texture: 3hwRW3GkH9M4Bj
            playAnimationOnStart: true
            loopAnimation: true
            animationFPS: 4
            visible: true
            events:
              - eventKey: OnStep
                lib: core
                code: >-
                  if (!pause.isPaused) {
                      // 1. Calcoliamo di quanti pixel ESATTI si muoverà in questo frame
                      // Moltiplicando per u.time, il passo sarà perfetto (es. 2.5 pixel)
                      let passo = this.velocitaPesce * u.time;

                      // --- DEBUG: SE SEI GIA' INCASTRATO ---
                      // Questo ti scriverà in console se il pesce nasce già dentro il muro!
                      if (place.occupied(this, this.x, this.y, 'Terreno')) {
                          console.log("ALLARME: Sono nato dentro il muro alle coordinate " + this.x + ", " + this.y);
                      }

                      // 2. MOVIMENTO A DESTRA
                      if (this.versoDestra) {
                          // Controlla se il prossimo ESATTO passo tocca il muro
                          if (place.occupied(this, this.x + passo, this.y, 'Terreno')) {
                              this.versoDestra = false; // Gira
                              this.scale.x = -this.baseScaleX;
                          } else {
                              this.x += passo; // Muoviti davvero
                          }
                      } 
                      // 3. MOVIMENTO A SINISTRA
                      else {
                          // Controlla se il prossimo ESATTO passo tocca il muro a sinistra
                          if (place.occupied(this, this.x - passo, this.y, 'Terreno')) {
                              this.versoDestra = true; // Gira
                              this.scale.x = this.baseScaleX;
                          } else {
                              this.x -= passo; // Muoviti davvero
                          }
                      }
                  }

                  // NOTA: NON usare this.move() qui sotto! Muoviamo this.x
                  manualmente.
                arguments: {}
              - eventKey: OnCreate
                code: >-
                  this.speed = 150;

                  this.direction = 0;

                  this.scale.x = .8;

                  this.scale.y = .8;


                  // Usiamo variabili nostre invece di quelle di sistema

                  this.velocitaPesce = 150; // Velocità in pixel al secondo
                  (cambiala come vuoi)

                  this.versoDestra = true;  // Scegli se parte andando a destra
                  o sinistra

                  this.baseScaleX = this.scale.x;
                arguments: {}
                lib: core
            extends:
              cgroup: Nemici
              'editor:myCollidingCGroups': []
            lastmod: 1776623552518
            uid: MPdrNr8hhh5b2R
            behaviors: []
            extendTypes: ''
          - type: template
            baseClass: AnimatedSprite
            name: Medusa
            depth: 10
            texture: GgCk1fwPDqDpj8
            playAnimationOnStart: true
            loopAnimation: true
            animationFPS: 4
            visible: true
            events:
              - eventKey: OnStep
                lib: core
                code: |-
                  if (!pause.isPaused) {
                      if (place.occupied(this, this.x, this.y + 5, 'Terreno')) {
                          this.direction = 270;  //direzione verso l'alto
                      } else if (place.occupied(this, this.x, this.y - 5, 'Terreno')) {
                          this.direction = 90;  //direzione verso il basso
                      }

                      this.move();
                  }
                arguments: {}
              - eventKey: OnCreate
                code: |-
                  this.speed = 150;
                  this.direction = 90;
                  this.scale.x = 3;
                  this.scale.y = 3;
                arguments: {}
                lib: core
            extends:
              cgroup: Nemici
              'editor:myCollidingCGroups': []
            lastmod: 1776623552501
            uid: gMww9zTNWQRDPT
            behaviors: []
            extendTypes: ''
      - type: folder
        uid: NDb6d6b9pqf89K
        colorClass: text
        icon: smiley-frown
        name: Collezionabili
        lastmod: 1774434010865
        entries:
          - type: template
            baseClass: AnimatedSprite
            name: Spazzatura_grande
            depth: 0
            texture: 2JtFWz3rPzL3R7
            playAnimationOnStart: false
            loopAnimation: true
            animationFPS: 30
            visible: true
            events:
              - eventKey: OnCreate
                code: |-
                  this.isCollected = false;
                  sounds.play('Generazione Spazzatura');
                  this.tex = "Grande" + Math.floor(Math.random() * 2 + 1);
                  this.scale.x = 1.3
                  this.scale.y = 1.3
                  this.puzza = emitters.follow(this,'Puzza')
                arguments: {}
                lib: core
              - eventKey: collisionCGroup
                code: >-
                  if (!this.isCollected && !place.occupied(this, this.x, this.y,
                  'Giocatore').hasCollidedWithEnemy) {
                      sounds.play('Raccolta');
                      this.isCollected = true;
                      place.occupied(this, this.x, this.y, 'Giocatore').spazzaturaGrande.push(this);
                  }
                arguments:
                  group: Giocatore
                lib: place
              - eventKey: OnStep
                code: |
                  this.move();
                arguments: {}
                lib: core
              - eventKey: OnDestroy
                code: |
                  do {
                      var x = Math.floor(random(camera.maxX));
                      var y = Math.floor(random(camera.maxY));
                  } while (place.occupied(this, x, y, 'Terreno'));

                  setTimeout(() => {
                      templates.copy('Spazzatura_grande', x, y);
                      sounds.play('Generazione Spazzatura');
                  }, 2000 + Math.floor(Math.random() * 3 * 1000));

                  emitters.stop(this.puzza)
                arguments: {}
                lib: core
            extends:
              cgroup: ''
              'editor:myCollidingCGroups': []
