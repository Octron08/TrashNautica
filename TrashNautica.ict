ctjsVersion: 5.3.1
backups: 2
language: typescript
notes: /* empty */
libs:
  place:
    gridX: 1024
    gridY: 1024
    debugMode: false
    debugText: 8
  pointer:
    startlocked: false
  keyboard: {}
  keyboard.polyfill: {}
  pointer.polyfill: {}
  gamepad: {}
  vkeys: {}
  transition: {}
  tween: {}
  random: {}
startroom: n8zd3bf8c5jPWg
contentTypes: []
actions:
  - name: P1MoveX
    methods:
      - code: keyboard.KeyD
      - code: keyboard.KeyA
        multiplier: -1
  - name: P1MoveY
    methods:
      - code: keyboard.KeyW
        multiplier: -1
      - code: keyboard.KeyS
  - name: P2MoveX
    methods:
      - code: keyboard.ArrowLeft
        multiplier: -1
      - code: keyboard.ArrowRight
  - name: P2MoveY
    methods:
      - code: keyboard.ArrowUp
        multiplier: -1
      - code: keyboard.ArrowDown
  - name: P1Reset
    methods:
      - code: keyboard.Digit1
  - name: P2Reset
    methods:
      - code: keyboard.Enter
scripts:
  - name: tutto
    code: |-
      /* Use scripts to define frequent functions and import small libraries */

      // Gestione pausa
      const pause = {
          isPaused: false,
          togglePaused: function () {
              this.isPaused = !this.isPaused;
          }
      }

      const gini = "ebreo";
assets:
  - type: folder
    uid: r5HR4k2wtQq24z
    colorClass: act
    icon: archive
    name: assets
    lastmod: 1773837946390
    entries:
      - type: folder
        uid: NPP9wJjGqb4WFt
        colorClass: success
        icon: physics
        name: Giocatore
        lastmod: 1773852820960
        entries:
          - type: template
            baseClass: AnimatedSprite
            name: Giocatore1
            depth: 3
            texture: 391HtTF4DJcp5r
            playAnimationOnStart: true
            loopAnimation: true
            animationFPS: 30
            visible: true
            events:
              - eventKey: OnStep
                lib: core
                code: |-
                  if (!pause.isPaused) {
                      var maxSpeed = 240 - 10 * this.spazzaturaGrande.length;
                      var friction = 0.05

                      //direzione del personaggio
                      if (actions.P1MoveY.down) this.scale.y = this.defaultScale.y * (actions.P1MoveY.value >= 0 ? 1 : -1);
                      if (actions.P1MoveX.down) this.scale.x = this.defaultScale.x * (actions.P1MoveX.value > 0 ?  -1 : 1);
                      if (actions.P1MoveY.value == -1) {
                          this.rotation = (actions.P1MoveX.down) ? (this.scale.x > 0 ? -45 : 45) : 0;
                      } else this.rotation = 0;

                      // Gestione movimento e collisione
                      if (this.hasCollidedWithEnemy) {
                          this.hspeed = !place.occupied(this, this.x + 3 * actions.P1MoveX.value, this.y, "Terreno") ? this.hspeed : -this.hspeed;
                          this.vspeed = !place.occupied(this, this.x, this.y + 3 * actions.P1MoveY.value, "Terreno") ? this.vspeed : -this.vspeed;

                      } else {
                          var targetSpeedX = actions.P1MoveX.down ? maxSpeed * actions.P1MoveX.value : 0;
                          var targetSpeedY = actions.P1MoveY.down ? maxSpeed * actions.P1MoveY.value : 0;

                          this.hspeed += (targetSpeedX - this.hspeed) * friction;
                          this.vspeed += (targetSpeedY - this.vspeed) * friction;
                          this.hspeed = place.occupied(this, this.x + 10 * actions.P1MoveX.value, this.y, "Terreno") ? 0 : this.hspeed;
                          this.vspeed = place.occupied(this, this.x, this.y + 10 * actions.P1MoveY.value, "Terreno") ? 0 : this.vspeed;
                      }

                      // "Rendering" spazzatura grande ancorata al giocatore
                      var offsetSpazzatura = 40;

                      if (actions.P1Reset.down) {
                          this.x = this.spawnX;
                          this.y = this.spawnY;
                          this.hspeed = 0;
                          this.vspeed = 0;
                          
                          if (this.spazzaturaGrande.length > 0) {
                              for (let i of this.spazzaturaGrande) i.kill = true;
                              this.spazzaturaGrande = [];
                          }
                      }

                      for (let i = 0; i < this.spazzaturaGrande.length; i++) { // Yay inefficienza!!
                          this.spazzaturaGrande[i].x = this.x;
                          this.spazzaturaGrande[i].y = this.y + offsetSpazzatura * i;
                      }

                      this.move();
                  }
                arguments: {}
              - eventKey: collisionCGroup
                code: |-
                  if (!this.hasCollidedWithEnemy && !pause.isPaused) {
                      this.hspeed = -this.hspeed;
                      this.vspeed = -this.vspeed;
                      sounds.play('Danno');

                      if (this.spazzaturaGrande.length > 0) {
                          // TODO: Gestione migliore della posizione nuova della spazzatura
                          do {
                              var maxDist = 40;
                              var targetDeltaX = Math.floor(Math.random() * maxDist) - maxDist/2;
                              var targetDeltaY = Math.floor(Math.random() * maxDist) - maxDist/2;
                              var validDelta = false;

                              validDelta = place.occupied(this, this.x + targetDeltaX, this.y + targetDeltaX, 'Terreno');
                          } while (validDelta != false);
                          
                          this.spazzaturaGrande[this.spazzaturaGrande.length - 1].x += targetDeltaX;
                          this.spazzaturaGrande[this.spazzaturaGrande.length - 1].y += targetDeltaY;
                          this.spazzaturaGrande[this.spazzaturaGrande.length - 1].isCollected = false;
                          this.spazzaturaGrande.pop();
                      }

                      this.hasCollidedWithEnemy = true;

                      var blinkInterval = setInterval(() => {
                          if (!pause.isPaused) this.alpha = this.alpha == 1 ? 0.2 : 1;
                      }, 100);

                      setTimeout(() => {
                          this.hasCollidedWithEnemy = false;
                          clearInterval(blinkInterval);

                          this.alpha = 1;
                      }, 1500);
                  }
                arguments:
                  group: Nemici
                lib: place
              - eventKey: OnCreate
                code: |-
                  this.hasCollidedWithEnemy = false;
                  this.spazzaturaGrande = [];

                  this.animationSpeed = 0.12;
                  this.defaultScale = {
                      x: this.scale.x,
                      y: this.scale.y
                  }

                  this.spawnX = this.x;
                  this.spawnY = this.y;
                arguments: {}
                lib: core
              - eventKey: collisionTemplate
                code: |-
                  if (this.spazzaturaGrande.length > 0) {

                      sounds.play('Spazzatura depositata');
                      scoreP1 += 100 * this.spazzaturaGrande.length;
                      for (let i of this.spazzaturaGrande) i.kill = true;

                      this.spazzaturaGrande = [];
                  }
                arguments:
                  template: w2cpWbbRcqhr4F
                lib: place
            extends:
              cgroup: Giocatore
              'editor:myCollidingCGroups':
                - Terreno
