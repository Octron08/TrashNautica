      - type: folder
        uid: 79kQbKmF72Nbdq
        colorClass: act
        icon: help-circle
        name: Nemici
        lastmod: 1774250395620
        entries:
          - type: template
            baseClass: AnimatedSprite
            name: Medusa
            depth: 10
            texture: GgCk1fwPDqDpj8
            playAnimationOnStart: true
            loopAnimation: true
            animationFPS: 4
            visible: true
            events:
              - eventKey: OnStep
                lib: core
                code: |-
                  if (!pause.isPaused) {
                      if (place.occupied(this, this.x + 5, this.y, 'Terreno')) {
                          this.direction = 180;
                      } else if (place.occupied(this, this.x - 5, this.y, 'Terreno')) {
                          this.direction = 0;
                      }

                      this.move();
                  }
                arguments: {}
              - eventKey: OnCreate
                code: |-
                  this.speed = 150;
                  this.direction = 0;
                  this.scale.x = 2;
                  this.scale.y = 2;
                arguments: {}
                lib: core
            extends:
              cgroup: Nemici
              'editor:myCollidingCGroups': []
            lastmod: 1775557636561
            uid: MPdrNr8hhh5b2R
            behaviors: []
            extendTypes: ''
          - type: template
            baseClass: AnimatedSprite
            name: Medusa_Verticale
            depth: 10
            texture: GgCk1fwPDqDpj8
            playAnimationOnStart: true
            loopAnimation: true
            animationFPS: 4
            visible: true
            events:
              - eventKey: OnStep
                lib: core
                code: |-
                  if (!pause.isPaused) {
                      if (place.occupied(this, this.x, this.y + 5, 'Terreno')) {
                          this.direction = 270;  //direzione verso l'alto
                      } else if (place.occupied(this, this.x, this.y - 5, 'Terreno')) {
                          this.direction = 90;  //direzione verso il basso
                      }

                      this.move();
                  }
                arguments: {}
              - eventKey: OnCreate
                code: |-
                  this.speed = 150;
                  this.direction = 90;
                  this.scale.x = 2;
                  this.scale.y = 2;
                arguments: {}
                lib: core
            extends:
              cgroup: Nemici
              'editor:myCollidingCGroups': []
