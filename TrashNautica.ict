        lastmod: 1775598456819
        events:
          - eventKey: OnRoomStart
            code: |-
              countDown = 120; // In secondi 

              this.isOver = false;

              this.text = "Tempo: " + Math.ceil(countDown).toString() + 's';

              // Lo sta facendo Orlando
              if (!pause.isPaused) pause.togglePaused();

              transition.fadeIn(1500, 0)
              .then(() => {
                  var prep_time = 3;
                  var cd = setInterval(() => {
                      if (prep_time > 0) {
                          // Cambia i secondi 
                          templates.list['Countdown'][0].text = prep_time;
                          prep_time--;
                      } else {
                          //
                          pause.togglePaused();
                          templates.list['Countdown'][0].text = "Via!";

                          setTimeout(() => {
                              templates.list['Countdown'][0].kill = true;
                          }, 1000);
                          
                          
                          clearInterval(cd);
                      }
                  }, 1000);
              });
            arguments: {}
            lib: core
          - eventKey: OnDraw
            code: |-
              if (!this.isOver && !pause.isPaused) {
                  countDown -= u.time;

                  let timeInSec = Math.ceil(countDown);
                  if (timeInSec < 0) timeInSec = 0;
                  
                  let timerText = templates.list['Timer'][0];

                  if (timerText) {
                      timerText.text = "Tempo: " + timeInSec.toString() + "s";
                  }

                  if (countDown <= 0) {
                      transition.fadeOut(1000, 0).then(() => {
                          this.finito = true;
                          pause.togglePaused();
                          rooms.switch("risultati");
                      });
                  }
              }
            arguments: {}
            lib: core
        behaviors: []
        extendTypes: ''
        uid: w2JHmN6CqWDt9G
