        entries:
          - type: template
            baseClass: AnimatedSprite
            name: Spazzatura_grande
            depth: 0
            texture: 2JtFWz3rPzL3R7
            playAnimationOnStart: false
            loopAnimation: true
            animationFPS: 30
            visible: true
            events:
              - eventKey: OnCreate
                code: this.isCollected = false;
